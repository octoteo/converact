{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://converact.dev/schemas/contract.schema.json",
  "title": "Converact Change Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","id","title","intent","riskLevel","status","constraints","nonGoals","standards","requirements","checks"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string","minLength": 1},
    "title": {"type": "string","minLength": 1},
    "intent": {"type": "string","minLength": 1},
    "riskLevel": {"enum": ["L0","L1","L2","L3"]},
    "status": {"enum": ["draft","active","accepted","aborted"]},
    "constraints": {"type": "array","items": {"type": "string"}},
    "nonGoals": {"type": "array","items": {"type": "string"}},
    "standards": {"type": "array","items": {"type": "string"}},
    "requirements": {"type": "array","items": {"type": "object","required": ["id","type","statement","priority","checks"],"properties": {"id":{"type":"string"},"type":{"enum":["behavior","invariant","interface","data","security","quality","recovery","compatibility","migration"]},"statement":{"type":"string"},"priority":{"enum":["must","should"]},"scope":{"type":"array","items":{"type":"string"}},"checks":{"type":"array","items":{"type":"string"}}}}},
    "checks": {"type": "array","items": {"type": "object","required": ["id","kind","description"],"properties": {"id":{"type":"string"},"kind":{"enum":["command","file","manual"]},"description":{"type":"string"},"command":{"type":"string"},"path":{"type":"string"},"contains":{"type":"string"},"timeoutMs":{"type":"integer","minimum":1}}}}
  }
}
